# ====================================================
# CryptoPlace Pro — Environment Configuration Example
# ====================================================

# Frontend
VITE_API_BASE_URL="http://localhost:5000/api"

# Backend
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cryptoplace?schema=public"
JWT_SECRET="replace_with_a_secure_random_string_in_production"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# External CoinGecko API
COINGECKO_API_KEY=""
COINGECKO_BASE_URL="https://api.coingecko.com/api/v3"
CACHE_TTL_SECONDS=60

# Allowed CORS Origins
FRONTEND_URL="http://localhost:5173"

